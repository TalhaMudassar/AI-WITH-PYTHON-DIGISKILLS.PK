   "source": [
    "import matplotlib.pyplot as plt\n",
    "\n",
    "# Object Oriented Workflow\n",
    "fig, ax = plt.subplots()\n",
    "\n",
    "# Label axes\n",
    "ax.set_title(\"Blank Figure Example\")\n",
    "ax.set_xlabel(\"X-axis Label\")\n",
    "ax.set_ylabel(\"Y-axis Label\")\n",
    "\n",
    "# Save to png\n",
    "fig.savefig(\"blank_plot.png\",dpi=100)\n",
    "\n",
    "plt.show()"
   ]
  }
